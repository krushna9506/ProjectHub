rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Users Collection & In-App Notifications
    match /users/{userId} {
      // Any authenticated student can view profiles (name, department, roll number)
      allow read: if isSignedIn();
      // Allow profile updates and allow project leads to update joinedProjectIds when joining
      allow write: if isSignedIn();

      // In-App Notifications Subcollection
      match /notifications/{notificationId} {
        allow read, write: if isSignedIn();
      }
    }

    // 2. Projects Collection & Subcollections (Tasks, Sprints, Files, Messages)
    match /projects/{projectId} {
      // Any authenticated user can read projects (essential for Search, Campus Explore, and Join via Code)
      allow read: if isSignedIn();

      // Any authenticated student can create a new project
      allow create: if isSignedIn();

      // Members and joining applicants can update project (e.g. adding self to members map)
      allow update: if isSignedIn();

      // Lead can delete project
      allow delete: if isSignedIn() && (resource == null || resource.data.leadId == request.auth.uid);

      // Subcollections: Tasks & Comments
      match /tasks/{taskId} {
        allow read, write: if isSignedIn();

        match /comments/{commentId} {
          allow read, write: if isSignedIn();
        }
      }

      // Subcollections: Sprints & Milestones
      match /milestones/{milestoneId} {
        allow read, write: if isSignedIn();
      }

      // Subcollections: Shared Files & Code Snippets
      match /files/{fileId} {
        allow read, write: if isSignedIn();
      }

      // Subcollections: Real-time Group Chat Messages
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // 3. Join Requests Collection (Campus Discovery)
    match /join_requests/{requestId} {
      allow read, write: if isSignedIn();
    }
  }
}
