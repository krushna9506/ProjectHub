<resources>
    <style name="Theme.ProjectHub" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand & Primary Containers -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Secondary / Accent Containers -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/primary_light</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_container</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/accent</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorTertiaryContainer">@color/accent_light</item>
        <item name="colorOnTertiaryContainer">@color/on_accent_container</item>

        <!-- Surfaces & Outlines -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/background</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <!-- Error -->
        <item name="colorError">@color/priority_urgent</item>
        <item name="colorOnError">@color/on_primary</item>

        <!-- System Bars & Window -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
