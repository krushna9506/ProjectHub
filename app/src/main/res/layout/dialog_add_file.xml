<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share File, Code or Link"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary" />

    <!-- Resource Type Selector -->
    <RadioGroup
        android:id="@+id/rgResourceType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <RadioButton
            android:id="@+id/rbTypeLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Link"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rbTypeDeviceFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload File"
            android:layout_marginStart="6dp" />

        <RadioButton
            android:id="@+id/rbTypeCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Code"
            android:layout_marginStart="6dp" />

        <RadioButton
            android:id="@+id/rbTypeGitHub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GitHub"
            android:layout_marginStart="6dp" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Resource Title (e.g. Firebase Auth Helper / Figma)" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- URL Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFileUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFileUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Resource URL (e.g. https://...)"
            android:inputType="textUri" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Language Input (for Code Snippets) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFileLang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFileLang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Language (e.g. Java, Kotlin, Python, XML)" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Code Snippet Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFileSnippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFileSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste Code Snippet here..."
            android:fontFamily="monospace"
            android:inputType="textMultiLine"
            android:minLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Device File Picker Section -->
    <LinearLayout
        android:id="@+id/layoutDeviceFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickDeviceFile"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📁 Choose Document / Image"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvSelectedFileStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:text="No file selected yet" />

        <ProgressBar
            android:id="@+id/pbUploadStorage"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUploadStoragePercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:visibility="gone"
            android:text="Uploading: 0%" />
    </LinearLayout>

</LinearLayout>
