<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvProjectAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_project_avatar"
                android:gravity="center"
                android:textColor="@color/on_primary_container"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="P" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProjectTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_primary"
                    android:text="Project Title" />

                <TextView
                    android:id="@+id/tvProjectCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_category_pill"
                    android:textColor="@color/text_secondary"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:text="GENERAL" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvJoinCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_code_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:fontFamily="monospace"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary_container"
                android:text="ABCD12" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvProjectDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_secondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:textSize="13sp"
            android:text="Project description goes here..." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvProjectMembersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:text="1 member" />

            <TextView
                android:id="@+id/tvProjectDeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:text="Active" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <ProgressBar
                android:id="@+id/pbProjectProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/bg_progress_rounded" />

            <TextView
                android:id="@+id/tvProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:text="0%" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
