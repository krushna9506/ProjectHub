<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <!-- Sent Message Layout (Current User) -->
    <LinearLayout
        android:id="@+id/layoutSent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/bubbleSentContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="290dp"
            android:orientation="vertical"
            android:background="@drawable/bg_chat_bubble_sent"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvReplyQuoteSent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="#26000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/on_primary"
                android:textSize="11.5sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvMessageSent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:text="My sent message" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutReactionsSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTimeSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:text="12:34 PM" />
    </LinearLayout>

    <!-- Received Message Layout (Teammates / Bot) -->
    <LinearLayout
        android:id="@+id/layoutReceived"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvAvatarReceived"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:textColor="@color/on_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="A" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="Alex (Teammate)" />

            <LinearLayout
                android:id="@+id/bubbleReceivedContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxWidth="290dp"
                android:orientation="vertical"
                android:background="@drawable/bg_chat_bubble_received"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tvReplyQuoteReceived"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_code_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/on_primary_container"
                    android:textSize="11.5sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvMessageReceived"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:text="Teammate received message" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutReactionsReceived"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTimeReceived"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:text="12:35 PM" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
