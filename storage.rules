rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Project files, documents, APKs, diagrams & images uploaded by teammates
    match /project_files/{projectId}/{fileName} {
      // Any authenticated student/member can read or download project files
      allow read: if request.auth != null;
      // Allow upload up to 50MB per file for authenticated team members
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
